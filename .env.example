# GEMINI_API_KEY: Optional Gemini AI API key for migration issue explanations.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key for migration issue explanations.
# If not configured, deterministic rule-based explanations are used automatically.
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB server used to store user accounts and login events.
# Example local: mongodb://127.0.0.1:27017/dataguard
# Example Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dataguard
MONGODB_URI="mongodb://127.0.0.1:27017/dataguard"

# Secret used to sign login session cookies. Change this in production.
JWT_SECRET="change-this-to-a-long-random-string"
